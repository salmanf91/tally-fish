{
  "name": "tally-fish",
  "version": "1.0.0",
  "description": "Daily Statement Application - Multi-Branch, Offline-Capable PWA with Background Web Push",
  "main": "backend/index.js",
  "scripts": {
    "start": "node backend/index.js",
    "dev": "node --watch backend/index.js",
    "seed": "node backend/db/seed.js",
    "test:api": "node backend/test-api.js",
    "migrate:up": "node-pg-migrate --envPath .env up",
    "migrate:down": "node-pg-migrate --envPath .env down",
    "migrate:create": "node-pg-migrate create"
  },
  "keywords": [
    "pwa",
    "postgresql",
    "migrations",
    "tally-fish",
    "node-pg-migrate"
  ],
  "author": "Pixelcodes",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1"
  }
}
